# Prefer ./node setup to create a private .env interactively.
COMPOSE_PROJECT_NAME=m3tering
POSTGRES_PASSWORD=replace-with-a-random-long-password
CHAIN_ID=11155111
RPC_URL=https://your-sepolia-rpc
ROLLUP_ADDRESS=0x9a9ED9b9A9BEC10d1B5E41b1873E78d19501D5Fa
HTTP_PORT=19000
PRIVATE_KEY=
SP1_PRIVATE_KEY=
STREAM_ID=
# Optional separate identity when the Streamr subscription needs authentication.
STREAMR_PRIVATE_KEY=
PROVING_ENABLED=false
PROVE_INTERVAL_SECONDS=43200
MAX_ACTIONS=10000
MAX_SLOTS=4096
MAX_BATCH_ACTIONS=1000
GAS_SCHEDULE=current
EXECUTION_GAS_BUDGET=15000000
TOTAL_GAS_BUDGET=15000000
FIXED_EXECUTION_ALLOWANCE=1500000
PER_WORD_OVERHEAD_ALLOWANCE=12000
MAX_FEE_PER_GAS_WEI=30000000000
MAX_PRIORITY_FEE_PER_GAS_WEI=1000000000
ETH_RESERVE_WEI=1000000000000000
MAX_PROVER_CYCLES=100000000
MAX_PROVER_PGU=100000000
# auto = live SP1 quote; numeric = PROVE wei per PGU (must match auction tick).
MAX_PRICE_PER_PGU=auto
# Optional hard per-proof cap in PROVE wei, excluding retained credit reserve.
MAX_PROOF_COST_WEI=
SP1_CREDIT_RESERVE_WEI=0
PROOF_TIMEOUT_SECONDS=3600
CONFIRMATIONS=2
# Standalone CLI only (Compose sets DATABASE_URL and SP1_ELF for you):
# DATABASE_URL=postgres://user:password@localhost/m3tering
# ACTIONS_FILE=actions.json
# OUTPUT_DIR=prover-output-batch-0
# SP1_ELF=release/program.elf

# Shared memory ceiling for SP1 native execution; allocated on demand.
WORKER_SHM_SIZE=1g
